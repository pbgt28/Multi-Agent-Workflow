    {
      "parameters": {
        "toolDescription": "Turns raw research material into 3-5 clearly structured key insights. Call this after the researcher has gathered facts and before the writer produces the final output.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('input', 'The research findings and factual material to analyse, plus the original task context.') }}",
        "options": {
          "systemMessage": "You are the Analyst Agent in a multi-agent collaboration framework. You receive factual research material and must distil it into 3 to 5 key, structured insights that directly serve the original task. For each insight, give a short bold headline followed by one or two sentences of explanation grounded strictly in the provided material. Do not introduce facts that were not present in the research — if the evidence is thin, note the gap. Prioritise relevance, non-redundancy, and decision-usefulness. Output only the structured insights; do not write the final report or email.",
          "maxIterations": 6
        }
      },
