    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.text ?? $input.first().json.output ?? '').toString().trim();\nconst cleaned = raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : { score: 0, feedback: 'Could not parse reviewer output: ' + cleaned };\n}\nconst score = Number(parsed.score);\nreturn [{ json: { output: { score: Number.isFinite(score) ? score : 0, feedback: String(parsed.feedback ?? '') } } }];"
      },
      "id": "5289b2c1-131c-4e8e-b49f-052d6f9cca80",
      "name": "Parse Review",
