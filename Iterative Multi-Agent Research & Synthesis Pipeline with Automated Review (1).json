    {
      "parameters": {
        "promptType": "define",
        "text": "=Original task:\n{{ $(\"Initialize Task\").item.json.task }}\n\nFinal output produced by the orchestrator:\n{{ $json.output }}\n\nEvaluate how well the final output satisfies the original task.",
        "messages": {
          "messageValues": [
            {
              "message": "You are the Reviewer Agent, a strict but fair quality evaluator in a multi-agent framework. You are given an original task and the final output produced for it. Score the output from 1 to 10 based on how completely, accurately, and clearly it fulfils the original task (10 = excellent, fully complete and accurate; 1 = fails the task). Provide concise, actionable feedback describing exactly what is missing or could be improved. Respond ONLY with a raw JSON object, no markdown fences, exactly in this shape: {\"score\": number, \"feedback\": \"text\"}."
            }
          ]
        },
        "batching": {}
      },
      "id": "401859ba-55b5-4c95-afe8-8a6e3e8ca128",
      "name": "Reviewer Agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
